{
  "name": "mansoorah",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mansoorah – trusted smart-home installation & tech maintenance in Oman (UTAS UNEP2109 prototype)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite-node scripts/gen-routes.ts && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\"",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.45.4",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "lighthouse": "^12.1.0",
    "prettier": "^3.3.3",
    "sharp": "^0.33.5",
    "tailwindcss": "4.1.11",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "@tailwindcss/node": "4.1.11",
    "@tailwindcss/oxide": "4.1.11",
    "tailwindcss": "4.1.11"
  }
}
